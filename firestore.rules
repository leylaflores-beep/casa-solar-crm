rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveCRMUser() {
      return request.auth != null && (
        request.auth.token.email == 'leyla.flores@gmail.com'
        || request.auth.token.email == 'ligiaeugeniamolina@gmail.com'
        || request.auth.token.email == 'casasolar.bodega.gt@gmail.com'
        || !exists(/databases/$(database)/documents/crm_data/user_$(request.auth.uid))
        || get(/databases/$(database)/documents/crm_data/user_$(request.auth.uid)).data.activo != false
      );
    }

    match /crm_data/{document} {
      allow read, write: if isActiveCRMUser();
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId
        || request.auth.token.email == 'leyla.flores@gmail.com');
      allow create: if request.auth != null
        && request.auth.token.email == 'leyla.flores@gmail.com';
      allow update: if request.auth != null
        && request.auth.token.email == 'leyla.flores@gmail.com';
      allow delete: if false;
    }

    match /public_campaigns/{campaignId} {
      allow get: if true;
      allow list, create, update, delete: if isActiveCRMUser();
    }

    match /campaign_links/{token} {
      allow get: if true;
      allow list, create, delete: if isActiveCRMUser();
      allow update: if isActiveCRMUser()
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessedAt', 'benefitRequestedAt']);
    }
  }
}
