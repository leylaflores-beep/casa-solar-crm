rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /crm_data/{document} {
      allow read, write: if request.auth != null;
    }

    match /public_campaigns/{campaignId} {
      allow get: if true;
      allow list, create, update, delete: if request.auth != null;
    }

    match /campaign_links/{token} {
      allow get: if true;
      allow list, create, delete: if request.auth != null;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accessedAt', 'benefitRequestedAt']);
    }
  }
}
